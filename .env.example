# API Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DEBUG=true

# Backend Service URLs
C_BACKEND_URL=http://localhost:8080
INVENTORY_SERVICE_URL=http://localhost:8081
POSTGRES_SERVICE_URL=http://localhost:5432

# Security
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
SESSION_EXPIRY_HOURS=24

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Redis Configuration (for production session storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/gateway.log